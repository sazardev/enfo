<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/w_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/w_pad">

        <TextView
            android:id="@+id/w_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/widget_music_label"
            android:textColor="@color/w_variant"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/w_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/w_on_surface"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/w_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:textColor="@color/w_variant"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <FrameLayout
                android:id="@+id/w_prev"
                android:layout_width="wrap_content"
                android:layout_height="40dp">

                <ImageView
                    android:id="@+id/w_prev_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/w_pill_container" />

                <ImageView
                    android:id="@+id/w_prev_icon"
                    android:layout_width="48dp"
                    android:layout_height="40dp"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/w_ic_prev" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/w_toggle"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp">

                <ImageView
                    android:id="@+id/w_toggle_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/w_pill_primary" />

                <ImageView
                    android:id="@+id/w_toggle_icon"
                    android:layout_width="64dp"
                    android:layout_height="40dp"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/w_ic_play" />
            </FrameLayout>

            <FrameLayout
                android:id="@+id/w_next"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp">

                <ImageView
                    android:id="@+id/w_next_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/w_pill_container" />

                <ImageView
                    android:id="@+id/w_next_icon"
                    android:layout_width="48dp"
                    android:layout_height="40dp"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/w_ic_next" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
