<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/w_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/w_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/w_pad">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/w_mark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/geist_mono_bold"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:text="“"
                android:textColor="@color/w_primary"
                android:textSize="34sp" />

            <TextView
                android:id="@+id/w_label"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="@font/geist_mono_regular"
                android:maxLines="1"
                android:paddingTop="6dp"
                android:text="@string/widget_quote_label"
                android:textColor="@color/w_variant"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/w_quote"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:autoSizeMaxTextSize="22sp"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeStepGranularity="1sp"
            android:autoSizeTextType="uniform"
            android:fontFamily="@font/geist_mono_medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:lineSpacingMultiplier="1.15"
            android:maxLines="5"
            android:textColor="@color/w_on_surface"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/w_day"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/geist_mono_regular"
            android:gravity="end"
            android:maxLines="1"
            android:textColor="@color/w_variant"
            android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
