    <color name="w_tile">#E3E3D3</color>
    <color name="w_on_surface">#1B1C16</color>
    <color name="w_variant">#46483A</color>
    <color name="w_primary">#506600</color>
    <color name="w_on_primary">#FFFFFF</color>
    <color name="w_container">#D2F17B</color>
    <color name="w_on_container">#161F00</color>
</resources>
